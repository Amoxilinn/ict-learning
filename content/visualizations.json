{
  "scenarios": [
    {
      "id": "journey",
      "unit": "ICT-001.02",
      "title": "同一份数据，逐段交给谁？",
      "summary": "点击下一步，区分最终目的 IP 与每段链路的接收接口。",
      "nodes": [
        [
          "pc",
          "电脑 A",
          80,
          80
        ],
        [
          "sw",
          "交换机",
          240,
          80
        ],
        [
          "gw",
          "路由器",
          400,
          80
        ],
        [
          "srv",
          "服务器",
          560,
          80
        ]
      ],
      "links": [
        [
          "pc",
          "sw"
        ],
        [
          "sw",
          "gw"
        ],
        [
          "gw",
          "srv"
        ]
      ],
      "columns": [
        "观察对象",
        "当前值"
      ],
      "steps": [
        {
          "title": "准备发送",
          "text": "A 为 192.168.10.10/24，服务器为 192.0.2.20。目的不在本地 /24，A 选择网关 192.168.10.1。",
          "rows": [
            [
              "最终目的 IP",
              "192.0.2.20"
            ],
            [
              "下一跳 IP",
              "192.168.10.1"
            ]
          ]
        },
        {
          "title": "A → 交换机",
          "text": "已解析网关 MAC 后，A 发出目的 MAC 为网关接口的帧。IP 包的目的仍是服务器。",
          "active": [
            [
              "pc",
              "sw"
            ]
          ],
          "rows": [
            [
              "目的 MAC",
              "网关左侧接口"
            ],
            [
              "目的 IP",
              "192.0.2.20"
            ]
          ]
        },
        {
          "title": "交换机 → 网关",
          "text": "假设 MAC 表已有网关表项，交换机按目的 MAC 转发，不把自己的 MAC 填成帧的源地址。",
          "active": [
            [
              "sw",
              "gw"
            ]
          ],
          "rows": [
            [
              "目的 MAC",
              "网关左侧接口（不变）"
            ],
            [
              "目的 IP",
              "192.0.2.20（不变）"
            ]
          ]
        },
        {
          "title": "路由器 → 服务器",
          "text": "路由器去掉入站链路封装，查路由、递减 IPv4 TTL 并更新头部校验和；在出口重新封装。",
          "active": [
            [
              "gw",
              "srv"
            ]
          ],
          "rows": [
            [
              "源 / 目的 MAC",
              "路由器右侧接口 / 服务器"
            ],
            [
              "源 / 目的 IP",
              "192.168.10.10 / 192.0.2.20"
            ]
          ]
        }
      ],
      "boundary": "假设服务器网段直连路由器，链路、路由及 ARP 就绪，无 NAT、隧道、分片和策略阻断。IP 地址不变不代表整个 IP 头不变。箭头表示转发事件，不代表耗时或物理距离。",
      "sources": [
        [
          "RFC 1812 · IPv4 路由器要求",
          "https://www.rfc-editor.org/rfc/rfc1812.html"
        ]
      ]
    },
    {
      "id": "vrp",
      "unit": "ICT-001.01",
      "title": "命令视图与保存，是两件事",
      "summary": "逐步观察提示符与配置状态；命令仅作教学示例。",
      "columns": [
        "观察对象",
        "当前状态"
      ],
      "steps": [
        {
          "title": "用户视图",
          "text": "<HUAWEI>：查看设备状态。从用户视图执行 system-view 进入系统视图。",
          "rows": [
            [
              "提示符",
              "<HUAWEI>"
            ],
            [
              "运行配置 / 启动配置",
              "旧配置 / 旧配置"
            ]
          ]
        },
        {
          "title": "系统视图",
          "text": "[HUAWEI]：执行 interface GigabitEthernet 0/0/1，进入该接口视图。接口名以实际设备为准。",
          "rows": [
            [
              "提示符",
              "[HUAWEI]"
            ],
            [
              "运行配置 / 启动配置",
              "旧配置 / 旧配置"
            ]
          ]
        },
        {
          "title": "接口视图",
          "text": "执行 description TO-LAN 后，接口描述进入运行配置。这个变更不等于已经写入启动配置。",
          "rows": [
            [
              "提示符",
              "[HUAWEI-GigabitEthernet0/0/1]"
            ],
            [
              "运行配置 / 启动配置",
              "新描述 / 旧配置"
            ]
          ]
        },
        {
          "title": "返回用户视图",
          "text": "执行 return 回到用户视图。退出视图不撤销刚才的运行配置，也不自动保存。",
          "rows": [
            [
              "提示符",
              "<HUAWEI>"
            ],
            [
              "运行配置 / 启动配置",
              "新描述 / 旧配置"
            ]
          ]
        },
        {
          "title": "保存成功后",
          "text": "执行 save 并按设备提示确认，保存成功后才更新启动配置。仍需回读配置并验证业务。",
          "rows": [
            [
              "提示符",
              "<HUAWEI>"
            ],
            [
              "运行配置 / 启动配置",
              "新描述 / 新描述"
            ]
          ]
        }
      ],
      "boundary": "常见 VRP V200 即时生效配置模式示意；其他平台可能需要 commit。提示符、接口名、保存过程随版本变化。本演示不连接设备，不模拟重启，也不证明业务可达。",
      "sources": [
        [
          "华为 · system-view",
          "https://info.support.huawei.com/hedex/api/pages/EDOC1100149308/AEJ0713J/17/resources/cli/system-view.html"
        ],
        [
          "华为 · 保存配置文件",
          "https://info.support.huawei.com/hedex/api/pages/EDOC1000053358/YEF0907R/25/resources/en-us_task_0141547205.html"
        ]
      ]
    },
    {
      "id": "encapsulation",
      "unit": "ICT-002.01",
      "title": "封装：给同一份内容逐层加说明",
      "summary": "点选字段可查看作用。块宽不表示字段字节数。",
      "columns": [
        "层次",
        "交付对象"
      ],
      "steps": [
        {
          "title": "应用数据",
          "text": "以已经建立的 TCP 连接发送一段应用数据为例。",
          "fields": [
            [
              "应用数据",
              "应用协议解释的内容。"
            ]
          ],
          "rows": [
            [
              "应用层",
              "对端应用"
            ]
          ]
        },
        {
          "title": "TCP 段",
          "text": "TCP 加入源/目的端口、序号、确认号等头部信息。",
          "fields": [
            [
              "TCP 头",
              "端口区分端点进程，序号与确认号支持有序可靠传输。"
            ],
            [
              "应用数据",
              "TCP 提供字节流，不保留应用每次写入的边界。"
            ]
          ],
          "rows": [
            [
              "传输层",
              "端口标识的端点"
            ]
          ]
        },
        {
          "title": "IPv4 包",
          "text": "IPv4 头给出源 IP、目的 IP、TTL 和上层协议等信息。",
          "fields": [
            [
              "IPv4 头",
              "本例 Protocol=6，表示负载交给 TCP。"
            ],
            [
              "TCP 头",
              "仍在 IP 负载内。"
            ],
            [
              "应用数据",
              "仍在 TCP 负载内。"
            ]
          ],
          "rows": [
            [
              "网际层",
              "目的 IP 标识的网络端点"
            ]
          ]
        },
        {
          "title": "以太网帧",
          "text": "帧头负责本链路交付，FCS 用于检测帧传输差错；接收端按相反顺序解析。",
          "fields": [
            [
              "目的 MAC · 6B",
              "本链路的下一跳接口。"
            ],
            [
              "源 MAC · 6B",
              "本链路发送接口。"
            ],
            [
              "类型 · 2B",
              "本例为 0x0800，表示 IPv4。"
            ],
            [
              "IPv4 包",
              "包含 IPv4 头、TCP 头和应用数据。"
            ],
            [
              "FCS · 4B",
              "用于检测差错，不是加密或可靠重传机制。"
            ]
          ],
          "rows": [
            [
              "网络接入层",
              "本链路下一跳"
            ]
          ]
        }
      ],
      "boundary": "Ethernet II + IPv4 + TCP 示例，无 VLAN 标签、IP/TCP 选项及分片。未画前导码、帧起始定界符及可能的填充；不是按比例的完整位布局。ARP 直接封装在以太网内，不套在 IPv4 中。",
      "sources": [
        [
          "RFC 894 · IP over Ethernet",
          "https://www.rfc-editor.org/rfc/rfc894.html"
        ],
        [
          "RFC 9293 · TCP",
          "https://www.rfc-editor.org/rfc/rfc9293.html"
        ]
      ]
    },
    {
      "id": "tcp",
      "unit": "ICT-002.02",
      "title": "三次握手：两端状态何时改变？",
      "summary": "箭头以接收端收到该报文为本步完成点。",
      "actors": [
        "客户端",
        "服务器"
      ],
      "columns": [
        "端点",
        "TCP 状态"
      ],
      "steps": [
        {
          "title": "初始状态",
          "text": "服务器已被动打开并监听；客户端尚未发起连接。",
          "rows": [
            [
              "客户端",
              "CLOSED"
            ],
            [
              "服务器",
              "LISTEN"
            ]
          ]
        },
        {
          "title": "SYN 到达服务器",
          "text": "客户端主动打开后进入 SYN-SENT。服务器收到 SYN，发送 SYN+ACK 后进入 SYN-RECEIVED。",
          "message": [
            0,
            1,
            "SYN · Seq=100"
          ],
          "rows": [
            [
              "客户端",
              "SYN-SENT"
            ],
            [
              "服务器",
              "SYN-RECEIVED"
            ]
          ]
        },
        {
          "title": "SYN+ACK 到达客户端",
          "text": "客户端收到合法 SYN+ACK 后进入 ESTABLISHED，并发出最后的 ACK。服务器此时仍等待 ACK。",
          "message": [
            1,
            0,
            "SYN+ACK · Seq=500 · Ack=101"
          ],
          "rows": [
            [
              "客户端",
              "ESTABLISHED"
            ],
            [
              "服务器",
              "SYN-RECEIVED"
            ]
          ]
        },
        {
          "title": "ACK 到达服务器",
          "text": "服务器收到合法 ACK 后进入 ESTABLISHED。SYN 各占用一个序号，因此确认号分别为 101 和 501。",
          "message": [
            0,
            1,
            "ACK · Seq=101 · Ack=501"
          ],
          "rows": [
            [
              "客户端",
              "ESTABLISHED"
            ],
            [
              "服务器",
              "ESTABLISHED"
            ]
          ]
        }
      ],
      "boundary": "普通主动/被动打开，无丢包、重传、同时打开或 SYN 携带数据，初始序号为教学选值。ACK 本身不消耗序号；握手完成不等于业务请求已成功，也不代表连接已加密。",
      "sources": [
        [
          "RFC 9293 §3.5 · 连接建立",
          "https://www.rfc-editor.org/rfc/rfc9293.html#section-3.5"
        ]
      ]
    },
    {
      "id": "arp-local",
      "unit": "ICT-002.04",
      "title": "ARP：问的是本地终端，还是网关？",
      "summary": "切换场景会回到起点，并清空这次演示的缓存。",
      "variant": "arp",
      "label": "同网段目的",
      "actors": [
        "A · 192.168.10.10",
        "B · 192.168.10.20"
      ],
      "columns": [
        "A 的 ARP 缓存 IP",
        "MAC（示例末字节）"
      ],
      "steps": [
        {
          "title": "选择下一跳",
          "text": "A 的前缀为 /24。B 位于同网段，下一跳为 B 自己，缓存为空。",
          "rows": []
        },
        {
          "title": "广播询问",
          "text": "ARP 请求询问谁拥有 192.168.10.20；以太网目的 MAC 为 FF:FF:FF:FF:FF:FF。同 VLAN 其他成员也会收到。",
          "message": [
            0,
            1,
            "请求 · Who has 192.168.10.20?"
          ],
          "rows": []
        },
        {
          "title": "B 单播回应",
          "text": "B 回答自己的 MAC。A 收到响应后建立映射；交换机的 MAC 表是另一张表。",
          "message": [
            1,
            0,
            "响应 · 192.168.10.20 is at …0B"
          ],
          "rows": [
            [
              "192.168.10.20",
              "02:00:00:00:00:0B"
            ]
          ]
        },
        {
          "title": "交付数据帧",
          "text": "A 将目的 IP 为 B 的 IP 包，装入目的 MAC 为 B 的以太网帧发送。",
          "message": [
            0,
            1,
            "IPv4 数据 · 目的 MAC=…0B"
          ],
          "rows": [
            [
              "192.168.10.20",
              "02:00:00:00:00:0B"
            ]
          ]
        }
      ],
      "boundary": "IPv4 以太网、同一 VLAN、无冲突或攻击；缓存开始为空，只显示 A 的缓存。图仅画通信双方，请求实际广播给本 VLAN 其他成员；不模拟超时、代理 ARP 或非请求方缓存更新。",
      "sources": [
        [
          "RFC 826 · ARP",
          "https://www.rfc-editor.org/rfc/rfc826.html"
        ]
      ]
    },
    {
      "id": "arp-gateway",
      "unit": "ICT-002.04",
      "title": "ARP：问的是本地终端，还是网关？",
      "summary": "切换场景会回到起点，并清空这次演示的缓存。",
      "variant": "arp",
